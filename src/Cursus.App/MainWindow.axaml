<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cursus.App.ViewModels"
        xmlns:views="using:Cursus.App.Views"
        xmlns:projects="using:Cursus.Core.Projects"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Cursus.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1000" Height="640"
        Title="Cursus">

    <Grid ColumnDefinitions="220,*">

        <!-- Rail des projets connus -->
        <DockPanel Grid.Column="0" Background="{DynamicResource ChromeRailBrush}">
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cursus" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Content="＋  Ajouter un projet"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Click="OnAddProjectClick" />
                    <!-- Vide tant que le dernier ajout a réussi ; sinon le refus lisible -->
                    <TextBlock Text="{Binding AddError}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="projects:Project">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="34">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Root}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,2"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).RemoveProjectCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Surface : le projet ouvert en mode run, ou un repère quand aucun n'est sélectionné -->
        <Panel Grid.Column="1">
            <ContentControl Content="{Binding CurrentSurface}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:OpenProjectViewModel">
                        <Panel>

                            <!-- Liste des workflows : le contenu par défaut de la surface (ni run, ni éditeur) -->
                            <DockPanel Margin="20" IsVisible="{Binding IsShowingList}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding Name}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,12" />

                                <!-- Volet catalogue : créer un workflow depuis un titre humain (l'id de fichier en est le slug) -->
                                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Text="{Binding NewWorkflowTitle, Mode=TwoWay}"
                                                 PlaceholderText="Titre d'un nouveau workflow"
                                                 Width="280" />
                                        <Button Content="＋  Nouveau workflow"
                                                Padding="12,6"
                                                Command="{Binding NewWorkflowCommand}" />
                                    </StackPanel>
                                    <!-- Vide tant que la dernière opération a réussi ; sinon le refus lisible -->
                                    <TextBlock Text="{Binding CatalogError}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Workflows}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkflowRowViewModel">
                                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">

                                                <!-- Mode normal : le passage se rouvre en relecture ; le workflow se lance, se renomme, se supprime -->
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsEditing}">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Button Content="{Binding LastPassage}"
                                                            IsEnabled="{Binding HasLastRun}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="0" FontSize="11"
                                                            HorizontalContentAlignment="Left"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).OpenPastRunCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsEditing}">
                                                    <Button Content="Éditer"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).OpenEditorCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Renommer"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding BeginRenameCommand}" />
                                                    <Button Content="✕"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).DeleteWorkflowCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="▸ Lancer"
                                                            Padding="12,6"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).StartRunCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>

                                                <!-- Mode renommage : le nouvel identifiant sera le slug du titre saisi -->
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding DraftTitle, Mode=TwoWay}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"
                                                         IsVisible="{Binding IsEditing}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsEditing}">
                                                    <Button Content="Renommer"
                                                            Padding="10,6"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).RenameWorkflowCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Annuler"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding CancelRenameCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Le run courant : même surface, autre contenu (pas de routeur) -->
                            <DockPanel IsVisible="{Binding IsShowingRun}">
                                <Border DockPanel.Dock="Top" Padding="12,8"
                                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                    <Button Content="‹ Retour à la liste"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding CloseRunCommand}" />
                                </Border>
                                <views:RunView DataContext="{Binding CurrentRun}" />
                            </DockPanel>

                            <!-- L'éditeur : troisième module de la même surface (D-016) -->
                            <DockPanel IsVisible="{Binding IsShowingEditor}">
                                <Border DockPanel.Dock="Top" Padding="12,8"
                                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                    <Button Content="‹ Retour à la liste"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding CloseEditorCommand}" />
                                </Border>
                                <ContentControl Content="{Binding CurrentEditor}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:WorkflowEditorViewModel">
                                            <ScrollViewer>
                                                <StackPanel Margin="20" Spacing="14">

                                                    <!-- En-tête : l'identifiant du workflow + enregistrer -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontSize="16" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding SavedNotice}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Button Content="Enregistrer"
                                                                    Padding="14,6"
                                                                    Command="{Binding SaveCommand}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Le point d'entrée -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="Entrée :" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <ComboBox ItemsSource="{Binding StepIds}"
                                                                  SelectedItem="{Binding EntryStep, Mode=TwoWay}"
                                                                  MinWidth="180" />
                                                    </StackPanel>

                                                    <!-- La validation en direct -->
                                                    <TextBlock Text="{Binding Problems}"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                                    <!-- Les étapes -->
                                                    <ItemsControl ItemsSource="{Binding Steps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StepEditorRow">
                                                                <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                                                        BorderThickness="1" CornerRadius="6"
                                                                        Padding="12" Margin="0,0,0,10">
                                                                    <StackPanel Spacing="8">

                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                <TextBlock Text="{Binding Id}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1"
                                                                                    Content="Supprimer l'étape"
                                                                                    Padding="10,4"
                                                                                    Background="Transparent"
                                                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                    Command="{Binding RemoveCommand}" />
                                                                        </Grid>

                                                                        <!-- Le script : local jusqu'à « Appliquer » -->
                                                                        <Grid ColumnDefinitions="*,180,Auto" >
                                                                            <TextBox Text="{Binding FileName, Mode=TwoWay}"
                                                                                     PlaceholderText="chemin de l'exécutable"
                                                                                     Margin="0,0,6,0" />
                                                                            <TextBox Grid.Column="1"
                                                                                     Text="{Binding Arguments, Mode=TwoWay}"
                                                                                     PlaceholderText="arguments"
                                                                                     Margin="0,0,6,0" />
                                                                            <Button Grid.Column="2"
                                                                                    Content="Appliquer"
                                                                                    Padding="10,6"
                                                                                    Command="{Binding ApplyScriptCommand}" />
                                                                        </Grid>

                                                                        <!-- Les arêtes sortantes -->
                                                                        <ItemsControl ItemsSource="{Binding Edges}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:EdgeEditorRow">
                                                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                                                        <TextBlock Text="{Binding Describe}"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                        <Button Grid.Column="1"
                                                                                                Content="✕"
                                                                                                Padding="8,2"
                                                                                                Background="Transparent"
                                                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                                Command="{Binding RemoveCommand}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- Tracer une arête : garde → cible -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <ComboBox ItemsSource="{Binding GuardChoices}"
                                                                                      SelectedItem="{Binding NewEdgeGuard, Mode=TwoWay}"
                                                                                      MinWidth="110" />
                                                                            <TextBlock Text="→" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            <ComboBox ItemsSource="{Binding TargetChoices}"
                                                                                      SelectedItem="{Binding NewEdgeTarget, Mode=TwoWay}"
                                                                                      MinWidth="150" />
                                                                            <Button Content="Ajouter l'arête"
                                                                                    Padding="10,6"
                                                                                    Command="{Binding AddEdgeCommand}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Ajouter une étape depuis son titre -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBox Text="{Binding NewStepTitle, Mode=TwoWay}"
                                                                 PlaceholderText="Titre d'une nouvelle étape"
                                                                 Width="260" />
                                                        <Button Content="＋  Ajouter l'étape"
                                                                Padding="12,6"
                                                                Command="{Binding AddStepCommand}" />
                                                    </StackPanel>

                                                </StackPanel>
                                            </ScrollViewer>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </DockPanel>

                        </Panel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <TextBlock Text="Choisissez un projet"
                       IsVisible="{Binding !HasOpenProject}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Panel>

    </Grid>
</Window>
