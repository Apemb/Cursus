<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cursus.App.ViewModels"
        xmlns:projects="using:Cursus.Core.Projects"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Cursus.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1000" Height="640"
        Title="Cursus">

    <Grid ColumnDefinitions="220,*">

        <!-- Rail des projets connus -->
        <DockPanel Grid.Column="0" Background="{DynamicResource ChromeRailBrush}">
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cursus" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Content="＋  Ajouter un projet"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Click="OnAddProjectClick" />
                    <!-- Vide tant que le dernier ajout a réussi ; sinon le refus lisible -->
                    <TextBlock Text="{Binding AddError}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="projects:Project">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="34">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Root}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,2"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).RemoveProjectCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Surface : le projet ouvert en mode run, ou un repère quand aucun n'est sélectionné -->
        <Panel Grid.Column="1">
            <ContentControl Content="{Binding CurrentSurface}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:OpenProjectViewModel">
                        <DockPanel Margin="20">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding Name}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />
                            <ListBox ItemsSource="{Binding Workflows}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="projects:WorkflowEntry">
                                        <TextBlock Text="{Binding Id}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <TextBlock Text="Choisissez un projet"
                       IsVisible="{Binding !HasOpenProject}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Panel>

    </Grid>
</Window>
