<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cursus.App.ViewModels"
        xmlns:views="using:Cursus.App.Views"
        xmlns:projects="using:Cursus.Core.Projects"
        xmlns:wf="using:Cursus.Core.Workflows"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Cursus.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1000" Height="640"
        Title="Cursus">

    <Grid ColumnDefinitions="220,*">

        <!-- Rail des projets connus -->
        <DockPanel Grid.Column="0" Background="{DynamicResource ChromeRailBrush}">
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Cursus" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Content="＋  Ajouter un projet"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Click="OnAddProjectClick" />

                    <!-- Création en attente : le dossier choisi n'est pas encore un projet, on le nomme avant de poser le .cursus/ -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsCreatingProject}">
                        <TextBox Text="{Binding CreateNameDraft, Mode=TwoWay}"
                                 PlaceholderText="Nom du projet" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Créer"
                                    Padding="12,6"
                                    Command="{Binding ConfirmCreateProjectCommand}" />
                            <Button Content="Annuler"
                                    Padding="12,6"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Command="{Binding CancelCreateProjectCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Vide tant que le dernier geste a réussi ; sinon le refus lisible -->
                    <TextBlock Text="{Binding AddError}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Border>

            <!-- Pied de rail : les réglages, au-dessus des projets comme les connexions
                 qu'ils portent — un jeton ne dépend d'aucun projet ouvert -->
            <Border DockPanel.Dock="Bottom" Padding="10,8"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
                <Button Content="⚙  Réglages"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding OpenSettingsCommand}" />
            </Border>

            <ListBox ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="34">

                            <!-- Mode normal : le nom, la racine, et les gestes renommer/retirer -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsEditing}">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Root}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsEditing}">
                                <Button Content="Renommer"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Command="{Binding BeginRenameCommand}" />
                                <Button Content="✕"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).RemoveProjectCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <!-- Mode renommage : réécrit le nom, jamais l'identité du projet -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding DraftName, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     IsVisible="{Binding IsEditing}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsEditing}">
                                <Button Content="OK"
                                        Padding="10,4"
                                        Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).RenameProjectCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Annuler"
                                        Padding="10,4"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Command="{Binding CancelRenameCommand}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Surface : le projet ouvert en mode run, ou un repère quand aucun n'est sélectionné -->
        <Panel Grid.Column="1">
            <ContentControl Content="{Binding CurrentSurface}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:OpenProjectViewModel">
                        <Panel>

                            <!-- Liste des workflows : le contenu par défaut de la surface (ni run, ni éditeur) -->
                            <DockPanel Margin="20" IsVisible="{Binding IsShowingList}">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="{Binding Name}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,12" />

                                <!-- Volet catalogue : créer un workflow depuis un titre humain (l'id de fichier en est le slug) -->
                                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Text="{Binding NewWorkflowTitle, Mode=TwoWay}"
                                                 PlaceholderText="Titre d'un nouveau workflow"
                                                 Width="280" />
                                        <Button Content="＋  Nouveau workflow"
                                                Padding="12,6"
                                                Command="{Binding NewWorkflowCommand}" />
                                    </StackPanel>
                                    <!-- Vide tant que la dernière opération a réussi ; sinon le refus lisible -->
                                    <TextBlock Text="{Binding CatalogError}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Workflows}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkflowRowViewModel">
                                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">

                                                <!-- Mode normal : cliquer le corps ouvre la page du workflow ; à droite, renommer / supprimer / lancer -->
                                                <Button Grid.Column="0"
                                                        IsVisible="{Binding !IsEditing}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="0" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).OpenWorkflowPageCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding LastPassage}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsEditing}">
                                                    <Button Content="Renommer"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding BeginRenameCommand}" />
                                                    <Button Content="✕"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).DeleteWorkflowCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="▸ Lancer"
                                                            Padding="12,6"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).StartRunCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>

                                                <!-- Mode renommage : le nouvel identifiant sera le slug du titre saisi -->
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding DraftTitle, Mode=TwoWay}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"
                                                         IsVisible="{Binding IsEditing}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsEditing}">
                                                    <Button Content="Renommer"
                                                            Padding="10,6"
                                                            Command="{Binding $parent[ListBox].((vm:OpenProjectViewModel)DataContext).RenameWorkflowCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Annuler"
                                                            Padding="10,6"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding CancelRenameCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Le run courant : même surface, autre contenu (pas de routeur) -->
                            <DockPanel IsVisible="{Binding IsShowingRun}">
                                <Border DockPanel.Dock="Top" Padding="12,8"
                                        BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                    <Button Content="‹ Retour"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding CloseRunCommand}" />
                                </Border>
                                <views:RunView DataContext="{Binding CurrentRun}" />
                            </DockPanel>

                            <!-- La page du workflow : historique + éditeur en onglets, sans routeur (D-016) -->
                            <DockPanel IsVisible="{Binding IsShowingPage}">
                                <ContentControl Content="{Binding CurrentWorkflowPage}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:WorkflowPageViewModel">
                                            <DockPanel>

                                                <!-- En-tête : retour, titre + Lancer, barre d'onglets -->
                                                <StackPanel DockPanel.Dock="Top">
                                                    <Border Padding="12,8"
                                                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <Button Content="‹ Retour à la liste"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                                    Command="{Binding CloseCommand}" />
                                                            <Button Grid.Column="1" Content="▸ Lancer"
                                                                    Padding="14,6"
                                                                    Command="{Binding LaunchCommand}" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding WorkflowId}"
                                                               Margin="20,14,20,0"
                                                               FontSize="18" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <!-- Onglets : le tab actif est désactivé (repère bon marché) ; Graphe/Déclencheurs à venir -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,10,20,0">
                                                        <Button Content="Historique"
                                                                Padding="10,5"
                                                                Command="{Binding SelectHistoryCommand}"
                                                                IsEnabled="{Binding !IsHistory}" />
                                                        <Button Content="Étapes"
                                                                Padding="10,5"
                                                                Command="{Binding SelectStepsCommand}"
                                                                IsEnabled="{Binding !IsSteps}" />
                                                        <TextBlock Text="Graphe · à venir"
                                                                   VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="Déclencheurs · à venir"
                                                                   VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Border Margin="0,10,0,0"
                                                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" />
                                                </StackPanel>

                                                <!-- Le contenu de l'onglet : historique OU éditeur -->
                                                <Panel>

                                                    <!-- Onglet Historique : un passage par ligne, clic = relecture -->
                                                    <ScrollViewer IsVisible="{Binding IsHistory}">
                                                        <StackPanel Margin="20" Spacing="4">
                                                            <TextBlock Text="Aucun passage pour l'instant — lancez le workflow."
                                                                       IsVisible="{Binding IsHistoryEmpty}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <ItemsControl ItemsSource="{Binding History}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:RunRowViewModel">
                                                                        <Button HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Left"
                                                                                Background="Transparent"
                                                                                Padding="10,8" Margin="0,0,0,4"
                                                                                Command="{Binding ReopenCommand}">
                                                                            <Grid ColumnDefinitions="90,*">
                                                                                <TextBlock Text="{Binding Verdict}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding When}"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            </Grid>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>

                                                    <!-- Onglet Étapes : l'éditeur existant, hébergé tel quel -->
                                                    <ContentControl Content="{Binding Editor}" IsVisible="{Binding IsSteps}">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate x:DataType="vm:WorkflowEditorViewModel">
                                                                <DockPanel>

                                                    <!-- Le graphe de définition, coiffant l'éditeur : seconde vue des
                                                         étapes (la silhouette), au-dessus de la liste qu'on édite. Borné
                                                         et défilant seul (il ne pousse pas la liste) ; replié quand le
                                                         workflow est vide. Patron Canvas emprunté à l'overlay de run :
                                                         connecteurs derrière (géométrie absolue), nœuds devant (placés en
                                                         Canvas.Left/Top). Nœuds nus — ni glyphe ni statut : c'est la forme,
                                                         pas un run. -->
                                                    <Border DockPanel.Dock="Top" Padding="14,10"
                                                            IsVisible="{Binding Graph.HasNodes}"
                                                            BorderBrush="{DynamicResource SeparatorBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <ScrollViewer MaxHeight="220"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <Panel Width="{Binding Graph.CanvasWidth}"
                                                                   Height="{Binding Graph.CanvasHeight}"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Top">

                                                                <ItemsControl ItemsSource="{Binding Graph.Connectors}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:GraphConnectorRow">
                                                                            <Canvas>
                                                                                <Path Data="{Binding Geometry}"
                                                                                      Stroke="{Binding Stroke}"
                                                                                      StrokeThickness="{Binding Thickness}"
                                                                                      StrokeDashArray="{Binding Dashes}" />
                                                                                <Path Data="{Binding Arrow}"
                                                                                      Fill="{Binding Stroke}" />
                                                                            </Canvas>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <ItemsControl ItemsSource="{Binding Graph.Nodes}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.Styles>
                                                                        <Style Selector="ContentPresenter" x:DataType="vm:DefinitionNodeRow">
                                                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                                        </Style>
                                                                    </ItemsControl.Styles>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:DefinitionNodeRow">
                                                                            <Border Width="{Binding Width}" Height="44"
                                                                                    Background="#FFFFFF"
                                                                                    BorderBrush="{DynamicResource SeparatorBrush}"
                                                                                    BorderThickness="1" CornerRadius="8"
                                                                                    Padding="10,0"
                                                                                    ToolTip.Tip="{Binding Label}">
                                                                                <TextBlock Text="{Binding Label}"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                           FontSize="13"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                            </Panel>
                                                        </ScrollViewer>
                                                    </Border>

                                                                <ScrollViewer>
                                                <StackPanel Margin="20" Spacing="14">

                                                    <!-- En-tête : l'identifiant du workflow + enregistrer -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontSize="16" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding SavedNotice}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Button Content="Enregistrer"
                                                                    Padding="14,6"
                                                                    Command="{Binding SaveCommand}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Le point d'entrée -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="Entrée :" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <ComboBox ItemsSource="{Binding StepIds}"
                                                                  SelectedItem="{Binding EntryStep, Mode=TwoWay}"
                                                                  MinWidth="180" />
                                                    </StackPanel>

                                                    <!-- La validation en direct -->
                                                    <TextBlock Text="{Binding Problems}"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                                    <!-- Les étapes -->
                                                    <ItemsControl ItemsSource="{Binding Steps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StepEditorRow">
                                                                <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                                                        BorderThickness="1" CornerRadius="6"
                                                                        Padding="12" Margin="0,0,0,10">
                                                                    <StackPanel Spacing="8">

                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                <TextBlock Text="{Binding Id}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1"
                                                                                    Content="Supprimer l'étape"
                                                                                    Padding="10,4"
                                                                                    Background="Transparent"
                                                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                    Command="{Binding RemoveCommand}" />
                                                                        </Grid>

                                                                        <!-- Le corps propre au kind : une commande pour un script,
                                                                             un modèle + un prompt pour un agent. Le ContentControl
                                                                             reçoit la ligne elle-même et choisit le gabarit par son
                                                                             type — le commun (en-tête, arêtes) reste autour, une fois. -->
                                                                        <ContentControl Content="{Binding}">
                                                                            <ContentControl.DataTemplates>

                                                                                <DataTemplate x:DataType="vm:ScriptStepRow">
                                                                                    <!-- La commande : une ligne, 1er token = binaire
                                                                                         (CommandLine). Descend seule à la perte de focus. -->
                                                                                    <TextBox Text="{Binding Command, Mode=TwoWay}"
                                                                                             PlaceholderText="commande (ex. dotnet build -warnaserror)"
                                                                                             FontFamily="Menlo, Cascadia Code, Consolas, monospace" />
                                                                                </DataTemplate>

                                                                                <DataTemplate x:DataType="vm:AgentStepRow">
                                                                                    <StackPanel Spacing="6">
                                                                                        <!-- Le modèle : affiché par libellé, retenu par id
                                                                                             (SelectedValueBinding). Descend dès la sélection. -->
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <TextBlock Text="Modèle :" VerticalAlignment="Center"
                                                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                            <ComboBox ItemsSource="{Binding Models}"
                                                                                                      SelectedValue="{Binding Model, Mode=TwoWay}"
                                                                                                      SelectedValueBinding="{Binding Id}"
                                                                                                      MinWidth="140">
                                                                                                <ComboBox.ItemTemplate>
                                                                                                    <DataTemplate x:DataType="wf:AgentModel">
                                                                                                        <TextBlock Text="{Binding Label}" />
                                                                                                    </DataTemplate>
                                                                                                </ComboBox.ItemTemplate>
                                                                                            </ComboBox>
                                                                                        </StackPanel>
                                                                                        <!-- Le prompt confié à l'agent. Multi-lignes ;
                                                                                             descend à la perte de focus. -->
                                                                                        <TextBox Text="{Binding Prompt, Mode=TwoWay}"
                                                                                                 PlaceholderText="prompt confié à l'agent"
                                                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                                                 MinHeight="64" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>

                                                                            </ContentControl.DataTemplates>
                                                                        </ContentControl>

                                                                        <!-- Les arêtes sortantes -->
                                                                        <ItemsControl ItemsSource="{Binding Edges}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:EdgeEditorRow">
                                                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                                                        <TextBlock Text="{Binding Describe}"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                        <Button Grid.Column="1"
                                                                                                Content="✕"
                                                                                                Padding="8,2"
                                                                                                Background="Transparent"
                                                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                                Command="{Binding RemoveCommand}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <!-- Tracer une arête : garde → cible -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <ComboBox ItemsSource="{Binding GuardChoices}"
                                                                                      SelectedItem="{Binding NewEdgeGuard, Mode=TwoWay}"
                                                                                      MinWidth="110" />
                                                                            <TextBlock Text="→" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            <ComboBox ItemsSource="{Binding TargetChoices}"
                                                                                      SelectedItem="{Binding NewEdgeTarget, Mode=TwoWay}"
                                                                                      MinWidth="150" />
                                                                            <Button Content="Ajouter l'arête"
                                                                                    Padding="10,6"
                                                                                    Command="{Binding AddEdgeCommand}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Ajouter une étape : choisir le kind, puis le titre. Le kind
                                                         est figé à la création (changer = supprimer + recréer). -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ComboBox ItemsSource="{Binding StepKinds}"
                                                                  SelectedItem="{Binding NewStepKind, Mode=TwoWay}"
                                                                  MinWidth="100" />
                                                        <TextBox Text="{Binding NewStepTitle, Mode=TwoWay}"
                                                                 PlaceholderText="Titre d'une nouvelle étape"
                                                                 Width="260" />
                                                        <Button Content="＋  Ajouter l'étape"
                                                                Padding="12,6"
                                                                Command="{Binding AddStepCommand}" />
                                                    </StackPanel>

                                                </StackPanel>
                                                                </ScrollViewer>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>

                                                </Panel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </DockPanel>

                        </Panel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <TextBlock Text="Choisissez un projet"
                       IsVisible="{Binding !HasOpenProject}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Panel>

        <!-- Réglages : superposés à toute la fenêtre, rail compris. Ils ne sont pas un
             module de la surface — ce qu'on y configure ne dépend d'aucun projet -->
        <Border Grid.Column="0" Grid.ColumnSpan="2"
                IsVisible="{Binding HasSettings}"
                Background="{DynamicResource ChromeRailBrush}">
            <ContentControl Content="{Binding Settings}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:TrackerSettingsViewModel">
                        <DockPanel Margin="24">

                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Connexions au tracker" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Un jeton par connexion. Il est rangé dans le trousseau du système, jamais sur le disque."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Fermer" VerticalAlignment="Top"
                                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseSettingsCommand}" />
                            </Grid>

                            <!-- Ajout en cours : le flux en deux temps, jeton puis portée -->
                            <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="14"
                                    IsVisible="{Binding Draft, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <ContentControl Content="{Binding Draft}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:TrackerConnectionDraft">
                                            <StackPanel Spacing="10">

                                                <!-- Premier temps : le jeton. On ne peut rien cocher
                                                     avant de savoir ce que cette clé donne à voir -->
                                                <StackPanel Spacing="6" IsVisible="{Binding !HasProbed}">
                                                    <TextBlock Text="Jeton d'API" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBox Grid.Column="0" Margin="0,0,8,0"
                                                                 PasswordChar="•"
                                                                 PlaceholderText="lin_api_…"
                                                                 Text="{Binding Token, Mode=TwoWay}" />
                                                        <Button Grid.Column="1" Content="Connecter"
                                                                IsEnabled="{Binding !IsProbing}"
                                                                Command="{Binding $parent[ContentControl].((vm:TrackerSettingsViewModel)DataContext).ProbeCommand}" />
                                                    </Grid>
                                                </StackPanel>

                                                <TextBlock Text="Interrogation du tracker…"
                                                           IsVisible="{Binding IsProbing}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="11"
                                                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                           Foreground="{DynamicResource DangerBrush}" />

                                                <!-- Second temps : ce que ce jeton dessert -->
                                                <StackPanel Spacing="8" IsVisible="{Binding HasProbed}">
                                                    <TextBlock Text="Nom de la connexion" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBox Text="{Binding Label, Mode=TwoWay}" />

                                                    <CheckBox Content="Tout ce que ce jeton voit"
                                                              IsChecked="{Binding CoversEverything, Mode=TwoWay}" />

                                                    <ScrollViewer MaxHeight="180" IsVisible="{Binding !CoversEverything}">
                                                        <ItemsControl ItemsSource="{Binding Projects}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:TrackerProjectChoiceRow">
                                                                    <CheckBox Content="{Binding Name}"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="Enregistrer"
                                                            IsVisible="{Binding HasProbed}"
                                                            Command="{Binding $parent[ContentControl].((vm:TrackerSettingsViewModel)DataContext).SaveCommand}" />
                                                    <Button Content="Annuler"
                                                            Command="{Binding $parent[ContentControl].((vm:TrackerSettingsViewModel)DataContext).CancelAddCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>

                            <Button DockPanel.Dock="Bottom" Content="＋  Ajouter une connexion"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                    IsVisible="{Binding Draft, Converter={x:Static ObjectConverters.IsNull}}"
                                    Command="{Binding BeginAddCommand}" />

                            <!-- L'absence de connexion est l'état d'une installation neuve : une
                                 invitation, pas une erreur -->
                            <TextBlock Text="Aucune connexion. Ajoutez-en une pour voir vos tâches dans Cursus."
                                       DockPanel.Dock="Top"
                                       IsVisible="{Binding HasNoConnection}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <ListBox ItemsSource="{Binding Connections}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrackerConnectionRow">
                                        <Grid ColumnDefinitions="*,Auto" MinHeight="34">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding ScopeLabel}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕"
                                                    VerticalAlignment="Center"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ListBox].((vm:TrackerSettingsViewModel)DataContext).RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </DockPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

    </Grid>
</Window>
