<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cursus.App.ViewModels"
             xmlns:sessions="using:Cursus.Core.Sessions"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="640"
             x:Class="Cursus.App.Views.SessionsView"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="260,4,*">

        <!-- Barre latérale : sessions -->
        <DockPanel Grid.Column="0" Background="{DynamicResource ChromeSidebarBrush}">
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sessions" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Content="＋  Nouvelle session"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Command="{Binding AddSessionCommand}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Workspace.Sessions}"
                     SelectedItem="{Binding Workspace.SelectedSession, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sessions:TerminalSession">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="34">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ShellPath}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,2"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).CloseSessionCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Background="{DynamicResource SeparatorBrush}" ResizeDirection="Columns" />

        <!-- Panneau terminal : rempli par le code-behind. Reste sombre : le terminal
             est une exception assumée au thème clair (presentation.md §9.5). -->
        <Panel Grid.Column="2" Name="TerminalHost" Background="{DynamicResource TerminalBackgroundBrush}">
            <TextBlock Name="EmptyPlaceholder"
                       Text="Aucune session — crée-en une pour ouvrir un terminal."
                       Foreground="{DynamicResource TerminalPlaceholderBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Panel>

    </Grid>
</UserControl>
