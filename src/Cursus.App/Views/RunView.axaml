<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cursus.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="560"
             x:Class="Cursus.App.Views.RunView"
             x:DataType="vm:RunViewModel">

    <DockPanel>

        <!-- En-tête du run : nom, statut, et le contrôle d'arrêt à trois positions -->
        <Border DockPanel.Dock="Top" Padding="20,14"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding WorkflowName}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Status}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Contrôle à trois positions : « Arrêter » actionnable, « Arrêt en
                     cours… » désactivé, « Arrêté » figé. Effacé sur un run abouti. -->
                <Button Grid.Column="2"
                        Content="{Binding StopLabel}"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding CanStop}"
                        IsVisible="{Binding IsControlVisible}"
                        VerticalAlignment="Center"
                        Padding="14,7" />
            </Grid>
        </Border>

        <!-- Trajectoire déroulée : une puce par visite, dans l'ordre de démarrage.
             La sélection est partagée avec le log ci-dessous. -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding Trajectory}"
                         SelectedItem="{Binding SelectedVisit, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunVisitRow">
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="4,3">
                                <TextBlock Text="{Binding Glyph}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Vue graphe : la sœur de la trajectoire, disposée en 2D (§7.12, D-017). Les
             nœuds sont placés par colonnes (profondeur, gauche→droite) par le layout de
             Core ; les connecteurs les relient — vert quand le routage les a pris, gris
             sinon, tiretés-arqués pour une boucle. Elle montre ce que la liste ne peut
             pas : les nœuds jamais atteints, les chemins morts, les cycles. Le canevas se
             dimensionne sur le graphe ; il défile s'il déborde. -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer MaxHeight="260"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel Width="{Binding Graph.CanvasWidth}" Height="{Binding Graph.CanvasHeight}"
                       HorizontalAlignment="Left" VerticalAlignment="Top">

                    <!-- Couche des connecteurs, derrière : chaque Path porte sa géométrie
                         absolue, donc un simple Canvas sans positionnement par item. -->
                    <ItemsControl ItemsSource="{Binding Graph.Connectors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GraphConnectorRow">
                                <Path Data="{Binding Geometry}"
                                      Stroke="{Binding Stroke}"
                                      StrokeThickness="{Binding Thickness}"
                                      StrokeDashArray="{Binding Dashes}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Couche des nœuds, devant : positionnés en Canvas.Left/Top depuis
                         la place pixel que le ViewModel a posée. -->
                    <ItemsControl ItemsSource="{Binding Graph.Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="vm:GraphNodeRow">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GraphNodeRow">
                                <!-- Largeur posée par le ViewModel (la colonne s'ajuste au
                                     plus large de ses libellés ; les connecteurs s'accrochent
                                     à ce bord). Grille Auto/*/Auto : la colonne * borne le
                                     libellé — l'ellipse ne sert que de filet au-delà du
                                     plafond de largeur. Infobulle = nom complet. -->
                                <Border Width="{Binding Width}" Height="44"
                                        Background="#FFFFFF"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="10,0"
                                        ToolTip.Tip="{Binding Label}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding VisitBadge}"
                                                   IsVisible="{Binding HasRevisits}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Panel>
            </ScrollViewer>
        </Border>

        <!-- Log de la visite sélectionnée. Fond sombre : le terminal est l'exception
             assumée au thème clair (presentation.md §9.5). -->
        <Panel Background="{DynamicResource TerminalBackgroundBrush}">
            <ScrollViewer Padding="16,12">
                <SelectableTextBlock Text="{Binding Log}"
                                     FontFamily="Menlo, Cascadia Code, Consolas, monospace"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource TerminalTextBrush}"
                                     TextWrapping="NoWrap" />
            </ScrollViewer>

            <TextBlock Text="En attente de sortie…"
                       IsVisible="{Binding !HasOutput}"
                       Foreground="{DynamicResource TerminalPlaceholderBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>

    </DockPanel>
</UserControl>
