<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Cursus</string>
    <key>CFBundleDisplayName</key>
    <string>Cursus</string>
    <key>CFBundleIdentifier</key>
    <string>dev.cursus.app</string>
    <key>CFBundleExecutable</key>
    <string>Cursus.App</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Sans cette clé, macOS rend l'app en 1x puis l'agrandit : le texte du
         terminal serait flou sur un écran Retina. -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Application à fenêtre ordinaire, présente dans le Dock. -->
    <key>LSUIElement</key>
    <false/>
</dict>
</plist>
