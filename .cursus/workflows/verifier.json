{
  "entryStep": "compiler",
  "steps": [
    {
      "id": "compiler",
      "name": "Compiler",
      "description": "Compiler sans le moindre avertissement",
      "maxVisits": 1,
      "script": {
        "fileName": "/bin/sh",
        "arguments": ["-c", "dotnet build -warnaserror"],
        "timeoutSeconds": 600
      },
      "edges": [
        { "guard": "success", "target": "tester" }
      ]
    },
    {
      "id": "tester",
      "name": "Tester",
      "description": "Passer toute la suite au vert",
      "maxVisits": 1,
      "script": {
        "fileName": "/bin/sh",
        "arguments": ["-c", "dotnet test"],
        "timeoutSeconds": 600
      },
      "edges": []
    }
  ]
}
